#!/usr/bin/env bash
# Run the integration tests: real firmware builds in the simulator against a mock server.
#
#   bin/spec                      # all of them, test modules in parallel (about 1.5 minutes)
#   bin/spec -j 1                 # one module at a time (-j N: at most N at once)
#   bin/spec --no-cache           # redo the factory flow and onboarding (as CI does)
#   bin/spec test_trmnl_x         # a module, class or test (unittest selectors)
#   bin/spec test_refresh_cycle.RefreshCycle.test_long_press_resets_wifi
#   bin/spec xteink_x4            # every test of a PlatformIO environment (by its env name)
#   bin/spec --list-envs          # the environments with tests, their test counts and builds
#   bin/spec --build-firmware xteink_x4   # pio run -e xteink_x4 first, then its tests
#
# Uses ../trmnl-firmware/.pio/build/<env> (TRMNL_FIRMWARE=<checkout> to use another one); tests
# skip themselves when their build is missing (asking for an env whose build is missing fails).
# Onboarded devices etc. are cached in target/spec-cache/, keyed by the firmware, the
# simulator and the test support code, so they are rebuilt whenever one changes.
# The firmware is only built with --build-firmware. See scripts/integration-tests.sh for more variables.
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-}" in
  -h | --help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    exit 0
    ;;
esac
exec scripts/integration-tests.sh "$@"

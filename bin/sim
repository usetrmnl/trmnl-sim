#!/usr/bin/env bash
# Build the simulator, then run a merged firmware image (its ELF next to it, the same path
# with .elf) on a board, given by the PlatformIO environment the firmware was built with.
#
#   bin/sim                                  # the window asks for the board and the image
#   bin/sim trmnl path/to/merged_firmware.bin
#   bin/sim trmnl path/to/merged_firmware.bin --erase   # more arguments go to trmnl-sim (--help)
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
  exit 0
fi

bin/build
exec ./target/release/trmnl-sim "$@"

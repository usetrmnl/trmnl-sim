#!/usr/bin/env bash
# Build the simulator, then run a merged firmware image (its ELF next to it, the same path
# with .elf). The board is the PlatformIO env in the image's name (FW1.8.17-<env>.bin), else
# --env.
#
#   bin/sim                                        # the window asks for the image and the board
#   bin/sim path/to/FW1.8.17-trmnl.bin
#   bin/sim path/to/merged_firmware.bin --env trmnl --erase   # more arguments: trmnl-sim --help
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
  exit 0
fi

bin/build
exec ./target/release/trmnl-sim "$@"

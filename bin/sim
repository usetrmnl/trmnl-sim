#!/usr/bin/env bash
# Build the simulator, then run it on a firmware build.
#
#   bin/sim                 # TRMNL OG (<firmware>/.pio/build/trmnl)
#   bin/sim TRMNL_X         # any PlatformIO env (<firmware>/.pio/build/<env>)
#   bin/sim path/to/build   # any PlatformIO build directory
#   bin/sim TRMNL_X --erase # arguments after the device go to trmnl-sim (see --help)
#
# <firmware> is ../trmnl-firmware unless TRMNL_FIRMWARE says otherwise. The firmware
# itself is not built here: run `pio run -e <env>` in the firmware checkout first.
set -euo pipefail
cd "$(dirname "$0")/.."

firmware="${TRMNL_FIRMWARE:-../trmnl-firmware}"
target="${1:-trmnl}"
[[ $# -gt 0 ]] && shift

case "$target" in
  -h | --help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    exit 0
    ;;
  -*)
    # No device given: default to the OG and pass everything on.
    set -- "$target" "$@"
    target=trmnl
    ;;
esac

# A path is a build directory; anything else is an env in the firmware checkout.
if [[ "$target" == */* ]]; then
  env=""
  build_dir="$target"
else
  env="$target"
  build_dir="$firmware/.pio/build/$env"
fi

if [[ ! -f "$build_dir/firmware.elf" ]]; then
  echo "error: no firmware build at $build_dir" >&2
  [[ -n "$env" ]] && echo "       build it with: (cd $firmware && pio run -e $env)" >&2
  exit 1
fi

bin/build
exec ./target/release/trmnl-sim "$build_dir" "$@"

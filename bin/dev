#!/usr/bin/env bash
# Build the simulator, then run it on a firmware build.
#
#   bin/dev                 # TRMNL OG   (<firmware>/.pio/build/trmnl)
#   bin/dev bwry            # TRMNL BWRY (<firmware>/.pio/build/trmnl_4clr)
#   bin/dev x               # TRMNL X    (<firmware>/.pio/build/TRMNL_X)
#   bin/dev path/to/build   # any PlatformIO build directory
#   bin/dev x --erase       # arguments after the device go to trmnl-sim (see --help)
#
# <firmware> is ../trmnl-firmware unless TRMNL_FIRMWARE says otherwise. The firmware
# itself is not built here: run `pio run -e <env>` in the firmware checkout first.
set -euo pipefail
cd "$(dirname "$0")/.."

firmware="${TRMNL_FIRMWARE:-../trmnl-firmware}"
target="${1:-og}"
[[ $# -gt 0 ]] && shift

case "$target" in
  og | trmnl) env=trmnl ;;
  bwry | 4clr | trmnl_4clr) env=trmnl_4clr ;;
  x | trmnl_x | TRMNL_X) env=TRMNL_X ;;
  -h | --help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    exit 0
    ;;
  -*)
    # No device given: default to the OG and pass everything on.
    set -- "$target" "$@"
    env=trmnl
    ;;
  *) env="" ;;
esac

if [[ -n "$env" ]]; then
  build_dir="$firmware/.pio/build/$env"
else
  build_dir="$target"
fi

if [[ ! -f "$build_dir/firmware.elf" ]]; then
  echo "error: no firmware build at $build_dir" >&2
  [[ -n "$env" ]] && echo "       build it with: (cd $firmware && pio run -e $env)" >&2
  exit 1
fi

bin/build
exec ./target/release/trmnl-sim "$build_dir" "$@"
